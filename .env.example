# Optional API keys for enhanced live data collection.
# The core dashboard can run without these keys; unavailable sources return empty
# data rather than fabricated values.
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
CURRENCY_API_KEY=
FRED_API_KEY=
FIXER_API_KEY=

# Local development server controls.
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
ENABLE_MODEL_UPDATE_ENDPOINT=FALSE

# Trading research configuration. The repository does not execute live trades.
MAX_POSITION_SIZE=0.10
RISK_TOLERANCE=MEDIUM
AUTO_TRADING=FALSE
